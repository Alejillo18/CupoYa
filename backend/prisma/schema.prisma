generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USUARIO
  OPERADOR
  ADMIN
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  passwordHash   String?   @map("password_hash")
  googleSub      String?   @unique @map("google_sub")
  role           Role      @default(USUARIO)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  refreshTokens  RefreshToken[] 
  reservations   Reservation[]
  reports        Report[]
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
enum EventStatus {
  ACTIVO
  CANCELADO
}

model Event {
  id                String      @id @default(uuid()) @db.Uuid
  name              String
  description       String      @default("")
  venue             String
  startsAt          DateTime    @map("starts_at")
  totalCapacity     Int         @map("total_capacity")
  availableCapacity Int         @map("available_capacity")
  status            EventStatus @default(ACTIVO)
  createdAt         DateTime    @default(now()) @map("created_at")
  reservations Reservation[]
  @@index([startsAt])
  @@map("events")
}

enum ReservationStatus {
  CONFIRMADA
  CANCELADA
}

model Reservation {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  eventId        String            @map("event_id") @db.Uuid
  quantity       Int
  status         ReservationStatus @default(CONFIRMADA)
  idempotencyKey String?           @map("idempotency_key")
  createdAt      DateTime          @default(now()) @map("created_at")
  cancelledAt    DateTime?         @map("cancelled_at")
  

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([eventId, status])
  @@index([userId])
  @@map("reservations")
}
enum ReportStatus {
  PENDIENTE
  EN_PROCESO
  LISTO
  ERROR
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  requestedBy  String       @map("requested_by") @db.Uuid
  status       ReportStatus @default(PENDIENTE)
  result       Json?
  errorMessage String?      @map("error_message")
  createdAt    DateTime     @default(now()) @map("created_at")
  finishedAt   DateTime?    @map("finished_at")

  user User @relation(fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([requestedBy, createdAt])
  @@map("reports")
}