# URL del frontend (nginx). Las pruebas de API también pasan por acá (/api/...).
BASE_URL=http://localhost:8080

# Conexión a la base, solo para preparar roles y limpiar datos de prueba.
# El puerto 5433 es el que publica docker-compose.yml.
DB_USER=cupoya
DB_PASSWORD=Contraseña
DB_PORT=5433
# O directamente la URL completa:
# E2E_DATABASE_URL=postgresql://cupoya:Contraseña@localhost:5433/cupoya
